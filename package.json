{
  "name": "ecommerce-legacy-solid",
  "version": "1.0.0",
  "description": "Projeto legado para refatora\u00e7\u00e3o SOLID",
  "main": "src/server.ts",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node -e \"require('fs').closeSync(require('fs').openSync('prisma/dev.db', 'a'))\" && prisma migrate dev --name init",
    "prisma:seed": "node --import tsx prisma/seed.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "dotenv": "^18.0.9",
    "express": "^4.21.0",
    "inversify": "^7.11.0",
    "nodemailer": "^7.0.11",
    "reflect-metadata": "^0.2.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.27",
    "@types/nodemailer": "^7.0.4",
    "prisma": "^6.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
